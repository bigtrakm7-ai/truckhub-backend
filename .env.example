# TruckGrad Backend — пример переменных окружения
# Скопируйте в .env для локальной разработки

ENV=dev
LOG_LEVEL=INFO
PROJECT_NAME=TruckGrad
SITE_URL=https://truckgrad.ru

# Локально (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./truckgrad.db

# Продакшен (Render PostgreSQL) — пример:
# DATABASE_URL=postgresql://user:pass@host/truckgrad

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — через запятую
CORS_ORIGINS=https://truckgrad.ru,https://www.truckgrad.ru,http://127.0.0.1:3023

PROVIDER_MODE=mock

REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
